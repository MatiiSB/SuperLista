# ── Supabase ───────────────────────────────────────────────
# Project URL and the browser-safe "publishable" (anon) key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service role key (server-only, NEVER expose to the client).
# Used for admin/migration tasks. Leave empty if not needed locally.
SUPABASE_SERVICE_ROLE_KEY=

# JWT secret (server-only). Used to sign custom guest JWTs for NFC realtime.
# Find it in your Supabase project: Settings → API → JWT Secret.
SUPABASE_JWT_SECRET=
# ── App ───────────────────────────────────────────────────
# Public site URL (used for OAuth redirects, manifest, deep links).
NEXT_PUBLIC_SITE_URL=https://superlista.app

# ── Barcode lookup (public API, no key required) ──────────
NEXT_PUBLIC_OPENFOODFACTS_BASE_URL=https://world.openfoodfacts.org
